{
    "extends": [
        "development"
    ],
    "hints": {
        "meta-viewport": "off",
        "no-inline-styles": "off",
        "compat-api/css": [
            "default",
            {
                "ignore": [
                    "scrollbar-width",
                    "scrollbar-color",
                    "scrollbar-gutter"
                ]
            }
        ]
    }
}
